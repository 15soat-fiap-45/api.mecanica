@startuml C4 Components - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_LEFT_RIGHT()

Container_Boundary(api, "Processo Fastify") {
    Component(fastify, "Fastify", "HTTP framework", "Cria a aplicação e recebe requests")
    Component(routes, "registry-routes", "Fastify + Zod", "POST/GET /customers e /vehicles")
    Component(error_handler, "Error handler", "Fastify", "Mapeia validação, aplicação e domínio para HTTP")
    Component(use_cases, "Registry use cases", "Application", "Register/Find Customer e Vehicle")
    Component(aggregates, "Registry domain", "Domain", "Customer, Vehicle e value objects")
    Component(repositories, "Registry repositories", "Ports", "CustomerRepository e VehicleRepository")
    Component(drizzle_adapters, "Drizzle repositories", "Infrastructure", "Persistência de cliente e veículo")
    Component(event_bus, "InMemoryEventBus", "Shared application", "Publica eventos de registro")
    Component(swagger, "Swagger / Swagger UI", "Fastify plugins", "OpenAPI; UI em /docs")
    Component(health, "Health check", "Fastify route", "GET /health executa SELECT 1")
}
Container_Boundary(other_contexts, "Módulos internos sem adaptador HTTP") {
    Component(service_order, "Service Order", "Domain + application", "OS, Budget e handlers de aprovação")
    Component(stock, "Stock", "Domain + application", "PartSupply, reservas, consumo e baixa")
}
System_Ext(postgres, "PostgreSQL", "Tabelas mapeadas pelo Drizzle: cliente, veiculo e servico")

Rel(fastify, routes, "registra")
Rel(fastify, error_handler, "configura")
Rel(fastify, swagger, "registra")
Rel(fastify, health, "registra")
Rel(routes, use_cases, "executa")
Rel(use_cases, aggregates, "cria e valida")
Rel(use_cases, repositories, "usa")
Rel(repositories, drizzle_adapters, "implementado por")
Rel(drizzle_adapters, postgres, "SQL via Drizzle")
Rel(use_cases, event_bus, "publica")
Rel(event_bus, service_order, "eventos de OS/orçamento")
Rel(event_bus, stock, "eventos de reservas/consumo")
Rel(health, postgres, "SELECT 1")

note right of other_contexts
    O bootstrap HTTP instancia somente o Registry.
    OS e Stock são compostos por contratos de repositório.
end note
SHOW_LEGEND()
@enduml
