@startuml C4 Containers - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(operator, "Operador Autenticado", "Usa Auth, Registry e Service Order conforme permissoes RBAC")
Person(customer, "Cliente do Veiculo", "Confirma a decisao sobre o orcamento recebido por e-mail")

System_Boundary(system, "API Oficina Mecanica") {
    Container(api, "Processo da API e Pagina de Orcamento", "Node.js / TypeScript / Fastify / Zod", "Auth, Registry e Service Order; Swagger, health check, public/orcamento.html e expiracao periodica de aprovacoes.")
    ContainerDb(postgres, "Banco da oficina", "PostgreSQL 17", "public: auth_users, cliente e veiculo. service_order: orders, supply_items, budgets, approval_requests e order_status_history.")
}
System_Ext(smtp, "Servidor SMTP", "Entrega de notificacoes transacionais")

Rel(operator, api, "Autentica, cadastra/consulta e avalia OS; salva descricao e envia orcamento", "HTTP/JSON + Bearer JWT")
Rel(customer, api, "Acessa pagina de confirmacao e aprova/recusa via token", "HTTP/HTML e JSON")
Rel(api, postgres, "Persiste usuarios, clientes, veiculos e OS, incluindo description; transacoes e versao otimista", "SQL via Drizzle ORM / pg")
Rel(api, smtp, "Envia descricao, valor e link do orcamento; notifica veiculo pronto", "SMTP / Nodemailer")

note bottom of api
    Camadas, casos de uso, repositorios e InMemoryEventBus
    sao componentes internos do mesmo processo.
    UpdateServiceOrderDescription salva a avaliacao em PENDING;
    AwaitBudgetApproval tambem aceita description opcional.
    O timer de 60s expira solicitacoes pendentes de aprovacao.
end note
SHOW_LEGEND()
@enduml
