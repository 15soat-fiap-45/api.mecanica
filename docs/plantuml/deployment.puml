@startuml Deployment - Estado Atual
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
LAYOUT_LEFT_RIGHT()

Deployment_Node(client, "Cliente da API", "Browser, curl ou outro consumidor HTTP") {
    Container(client_tool, "Cliente HTTP", "HTTP/JSON", "Chama os endpoints publicados")
}

Deployment_Node(dev_host, "Host Docker", "Docker Compose (docker-compose.yml na raiz)") {
    Deployment_Node(migrate_container, "migrate", "Container api-oficina:local, restart: no") {
        Container(migrate_job, "Job de migração", "Node.js 24 / drizzle-orm migrator", "node dist/infra/database/migrate.js; aplica ./drizzle e encerra")
    }

    Deployment_Node(api_container, "api", "Container api-oficina:local (node:24-bookworm-slim), usuário node") {
        Container(api_process, "API process", "Fastify / TypeScript", "node dist/index.js; HOST=0.0.0.0, PORT=3000; healthcheck em /health")
        Container(event_bus, "Barramento de eventos", "InMemoryEventBus", "Eventos de domínio entre Service Order, Stock e BI no mesmo processo")
        ContainerDb(drizzle, "Drizzle ORM", "node-postgres (pg Pool)", "Repositórios Auth, Registry, Stock, Service Order, BI e health check")
    }

    Deployment_Node(postgres_container, "postgres", "Container postgres:17 (oficina-postgres)") {
        ContainerDb(postgres, "Database", "PostgreSQL 17", "Schemas public (auth, registry, estoque), service_order e business_intelligence; volume postgres_data; init/*.sql no primeiro start")
    }

    Deployment_Node(mailhog_container, "mailhog", "Container mailhog/mailhog") {
        Container(mailhog, "MailHog", "SMTP 1025 / UI 8025", "Captura os e-mails de aprovação de orçamento em ambiente local")
    }
}

Rel(client_tool, api_process, "HTTP/JSON :3000 (API_PORT)", "Health, Swagger (/docs), Auth, Registry, Stock, Service Order e BI")
Rel(api_process, event_bus, "publica / assina")
Rel(api_process, drizzle, "usa")
Rel(drizzle, postgres, "TCP/SQL :5432")
Rel(api_process, postgres, "SELECT 1 no health check")
Rel(api_process, mailhog, "SMTP (nodemailer)", "SMTP_HOST=mailhog, SMTP_PORT=1025")
Rel(migrate_job, postgres, "TCP/SQL :5432", "migrações Drizzle")

note right of api_process
    Ordem de subida no Compose:
    postgres (healthy) -> migrate (concluído) -> api
    mailhog precisa estar iniciado antes da api.

    Não há no repositório atual:
    - cluster/orquestrador ou load balancer
    - Redis, S3 ou broker de mensageria externo
    - serviços externos de pagamento ou SMS
    - serviço SMTP externo de produção
end note

note right of postgres
    infra/postgres/docker-compose.yml provisiona
    postgres e mailhog; é incluído pelo
    docker-compose.yml da raiz, que adiciona
    os serviços migrate e api.
end note
SHOW_LEGEND()
@enduml
