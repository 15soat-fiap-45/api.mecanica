@startuml C4 Containers - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(client, "Consumidor HTTP", "Chama a API por HTTP/JSON")

System_Boundary(system, "API Oficina Mecanica") {
    Container(api, "Processo da API", "Node.js / TypeScript / Fastify", "Servidor, Swagger, health check e error handler")
    Container(http_adapters, "Adaptadores HTTP", "Fastify + Zod", "Rotas de Registry (CRUD protegido), Auth, Service Order e Business Intelligence")
    Container(application, "Camada de aplicação", "Casos de uso e handlers", "Registry, Auth, Service Order, Stock e Business Intelligence")
    Container(domain, "Domínio modular", "DDD", "Registry, Auth, Service Order, Stock e Business Intelligence")
    Container(event_bus, "Event Bus", "InMemoryEventBus", "Comunicação desacoplada entre contextos no mesmo processo")
    Container(drizzle, "Persistência Drizzle ORM", "Drizzle / node-postgres", "Repositórios concretos nos schemas public, service_order e business_intelligence")
}
System_Ext(postgres, "PostgreSQL", "Banco local/provisionado pelo Compose")

Rel(client, http_adapters, "HTTP/JSON", "Bearer JWT nas rotas protegidas")
Rel(http_adapters, application, "Valida e executa casos de uso")
Rel(application, domain, "Invoca agregados, entidades e políticas")
Rel(application, drizzle, "Usa interfaces de repositório")
Rel(drizzle, postgres, "SQL")
Rel(application, event_bus, "Publica eventos de domínio")
Rel(event_bus, application, "Notifica handlers e alimenta projeções de BI")
Rel(api, http_adapters, "Registra rotas Fastify no bootstrap")
Rel(api, event_bus, "Cria Event Bus no bootstrap")
Rel(api, postgres, "Health check SELECT 1")

note right of application
    O módulo de Business Intelligence consome eventos
    via EventBus e alimenta projeções exclusivas
    no schema business_intelligence (CQRS).
end note
SHOW_LEGEND()
@enduml
