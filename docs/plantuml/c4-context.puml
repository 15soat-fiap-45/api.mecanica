@startuml C4 Context - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(api_client, "Consumidor HTTP", "Cliente da API, ferramenta de integracao ou operador")
System(api, "API Oficina Mecanica", "Monolito modular em TypeScript com Fastify. Expõe health check, Swagger, Registry e Stock.")
System_Ext(postgres, "PostgreSQL", "Banco usado pelo Fastify/Drizzle para Registry e Stock.")

Rel(api_client, api, "HTTP/JSON", "Health, Swagger, Registry e Stock")
Rel(api, postgres, "SQL", "SELECT/INSERT via Drizzle")

note right of api
    Contextos modelados no código:
    - Registry: clientes e veículos
    - Service Order: OS e orçamento
    - Stock: peças, reservas e consumo

    Registry e Stock estão conectados às rotas HTTP
    e aos repositórios Drizzle no bootstrap atual.
    Service Order ainda não possui adaptador HTTP.
end note

SHOW_LEGEND()
@enduml
