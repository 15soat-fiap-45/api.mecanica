@startuml C4 Components - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_LEFT_RIGHT()

Container_Boundary(api, "Processo Fastify") {
    Component(fastify, "Fastify / Bootstrap", "src/app.ts e src/index.ts", "Registra Auth, Registry, Service Order, Business Intelligence, Swagger, health check e error handler")
    Component(auth, "Auth", "HTTP / Application / Domain", "Primeiro acesso, login JWT, usuarios e resolucao de atores/permissoes")
    Component(registry, "Registry", "HTTP / Application / Domain", "CRUD de clientes e veiculos protegido por JWT e CLIENTE_EDITAR; cliente altera so email/tel e veiculo so color")
    Component(service_http, "Rotas Service Order", "Fastify / Zod", "Comandos e consultas autenticados de OS; pagina publica e decisao de orcamento")
    Component(service_order, "Service Order", "Application / Domain", "UpdateServiceOrderDescription (PENDING), ciclo da OS, insumos, historico, AwaitBudgetApproval e DecideBudgetApproval")
    Component(actor, "TokenActorResolver", "Infrastructure", "Autentica JWT via Auth e verifica RBAC; CLIENTE_EDITAR no Registry e OS_CONCLUIR para descricao e envio de orcamento")
    Component(contact, "RegistryVehicleContactLookup", "Infrastructure", "Consulta contato do cliente a partir do veiculo")
    Component(drizzle, "Repositorios Drizzle", "Infrastructure", "Usuarios, clientes, veiculos, OS, orcamentos e solicitacoes de aprovacao")
    Component(event_bus, "InMemoryEventBus", "Shared application", "Entrega sequencial no processo; publica eventos e isola falhas dos handlers")
    Component(handlers, "Handlers Service Order", "Application", "MoveServiceOrderToApproved, SendBudgetApprovalEmail e SendVehicleReadyEmail")
    Component(email, "SmtpEmailSender", "Nodemailer", "Envia e-mails de orcamento com descricao da OS e de veiculo pronto")
    Component(expiry, "Job de Expiracao", "setInterval / Bootstrap", "Invoca expirePending() a cada 60s")
}
ContainerDb(postgres, "Banco da oficina", "PostgreSQL 17", "Schemas public e service_order")
System_Ext(smtp, "Servidor SMTP", "Entrega de e-mails")

Rel(fastify, auth, "Registra controller")
Rel(fastify, registry, "Registra rotas")
Rel(fastify, service_http, "Registra rotas")
Rel(fastify, expiry, "Inicia e encerra timer")
Rel(service_http, actor, "Autentica e autoriza")
Rel(registry, actor, "Autentica e autoriza")
Rel(actor, auth, "Resolve ator e permissoes")
Rel(service_http, service_order, "Executa casos de uso")
Rel(service_order, contact, "Valida veiculo e consulta contato")
Rel(contact, registry, "Consulta veiculo e cliente")
Rel(auth, drizzle, "Persiste usuarios")
Rel(registry, drizzle, "Persiste clientes e veiculos")
Rel(service_order, drizzle, "Persiste e consulta agregados e historico")
Rel(service_order, event_bus, "Publica eventos de OS/orcamento")
Rel(registry, event_bus, "Publica eventos de cadastro")
Rel(event_bus, handlers, "Entrega eventos")
Rel(handlers, drizzle, "Busca e atualiza OS/orcamento/aprovacao")
Rel(handlers, contact, "Consulta destinatario")
Rel(handlers, email, "Envia notificacao")
Rel(expiry, drizzle, "Expira aprovacoes pendentes")
Rel(drizzle, postgres, "SQL via Drizzle / pg")
Rel(email, smtp, "Envia mensagem", "SMTP")

note bottom of service_order
    A descricao da avaliacao substitui orders.description enquanto PENDING.
    A edicao isolada nao publica evento nem altera o status.
    Stock permanece sem handlers ativados no bootstrap atual.
    O detalhamento do modulo esta em c4-service-order-components.puml.
end note
SHOW_LEGEND()
@enduml
