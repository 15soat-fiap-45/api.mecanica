@startuml C4 Containers - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(client, "Consumidor HTTP", "Chama a API por HTTP/JSON")

System_Boundary(system, "API Oficina Mecanica") {
    Container(api, "Processo da API", "Node.js / TypeScript / Fastify", "Servidor, Swagger, health check e error handler")
    Container(registry_http, "Adaptador HTTP Registry", "Fastify + Zod", "POST/GET /customers e /vehicles")
    Container(application, "Camada de aplicação", "Casos de uso", "Registry; e casos de uso de Service Order e Stock")
    Container(domain, "Domínio modular", "DDD", "Registry, Service Order, Budget, Part Supply e Supply Reservation")
    Container(event_bus, "Event Bus", "InMemoryEventBus", "Eventos no mesmo processo; sem durabilidade, retry ou DLQ")
    Container(drizzle, "Persistência Registry", "Drizzle ORM", "Repositórios concretos de cliente e veículo")
}
System_Ext(postgres, "PostgreSQL", "Banco local/provisionado pelo Compose")

Rel(client, registry_http, "HTTP/JSON")
Rel(registry_http, application, "Valida e executa casos de uso")
Rel(application, domain, "Cria agregados, VOs e eventos")
Rel(application, drizzle, "Usa contratos de repositório")
Rel(drizzle, postgres, "SQL")
Rel(application, event_bus, "Publica eventos de domínio")
Rel(event_bus, application, "Handlers internos de OS/Stock")
Rel(api, registry_http, "Registra rotas")
Rel(api, event_bus, "Cria Event Bus no bootstrap")
Rel(api, postgres, "Health check SELECT 1")

note right of application
    Service Order e Stock não possuem rotas HTTP
    nem repositórios PostgreSQL concretos no estado atual.
end note
SHOW_LEGEND()
@enduml
