@startuml C4 Context - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(api_client, "Consumidor HTTP", "Cliente da API, ferramenta de integracao ou operador")
System(api, "API Oficina Mecanica", "Monolito modular em TypeScript com Fastify. Expõe health check, Swagger e o contexto Registry.")
System_Ext(postgres, "PostgreSQL", "Banco usado pelo Fastify/Drizzle. O schema mapeado pela aplicacao contém cliente, veiculo e servico.")

Rel(api_client, api, "HTTP/JSON", "GET /health, /docs\nPOST/GET /customers e /vehicles")
Rel(api, postgres, "SQL", "SELECT/INSERT via Drizzle")

note right of api
    Contextos modelados no código:
    - Registry: clientes e veículos
    - Service Order: OS e orçamento
    - Stock: peças, reservas e consumo

    Apenas Registry está conectado às rotas HTTP
    e aos repositórios Drizzle no bootstrap atual.
end note

SHOW_LEGEND()
@enduml
