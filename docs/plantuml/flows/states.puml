@startuml Estados do Domínio Atual
hide empty description

state "ServiceOrder" as SO {
    [*] --> PENDING
    PENDING --> AWAITING_APPROVAL
    PENDING --> APPROVED
    PENDING --> CANCELLED
    AWAITING_APPROVAL --> APPROVED
    AWAITING_APPROVAL --> REJECTED
    AWAITING_APPROVAL --> CANCELLED
    REJECTED --> [*]
    APPROVED --> IN_PROGRESS
    APPROVED --> CANCELLED
    IN_PROGRESS --> PAUSED
    IN_PROGRESS --> COMPLETED
    IN_PROGRESS --> CANCELLED
    PAUSED --> IN_PROGRESS
    PAUSED --> CANCELLED
    COMPLETED --> DELIVERED
    DELIVERED --> [*]
    CANCELLED --> [*]
}

state "Budget" as BUDGET {
    [*] --> B_PENDING
    B_PENDING --> B_APPROVED
    B_PENDING --> B_REJECTED
    B_APPROVED --> [*]
    B_REJECTED --> [*]
}

state "SupplyReservation" as RESERVATION {
    [*] --> R_PENDING
    R_PENDING --> R_CONFIRMED
    R_PENDING --> R_CANCELLED
    R_CONFIRMED --> R_CONSUMED
    R_CONFIRMED --> R_CANCELLED
    R_CANCELLED --> [*]
    R_CONSUMED --> [*]
}

state "PartSupply" as SUPPLY {
    [*] --> REGISTERED
    REGISTERED --> REGISTERED : entrada/saída de quantidade
}

note right of SO
    Valores e transições definidos em
    service-order-status.ts.
    Mudanças persistidas em
    service_order.order_status_history.
end note

note right of BUDGET
    Valores: PENDING, APPROVED, REJECTED.
    A aprovação publica service-order.budget-approved.
end note

note right of RESERVATION
    Valores: PENDING, CONFIRMED,
    CANCELLED, CONSUMED.
end note

note bottom of SUPPLY
    Não há máquina de estados de cliente
    ou pagamento implementada.
end note
@enduml
