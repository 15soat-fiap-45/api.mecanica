@startuml C4 Containers - API Mecânica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

Person(cliente, "👤 Cliente", "Fornecedor do veículo")
Person(recepcionista, "💼 Recepcionista", "Operador do sistema")
Person(mecanico, "🔧 Mecânico", "Executor dos serviços")
Person(gerente, "👨‍💼 Gerente", "Gestor/Administrator")

System_Boundary(api_mecanica, "API Mecânica") {
    Container(web_app, "🖥️ Web Application", "React / TypeScript", "Interface desktop e dashboard admin\nAcessada por recepcionistas e gerentes")
    Container(mobile_app, "📱 Mobile Application", "React Native", "App nativa para mecânicos\nAtualizações em tempo real")

    Container(api, "API Server", "Node.js / Express", "Lógica de negócio\nEndpoints REST\nOrquestração de serviços")
    Container(cache, "Cache Layer", "Redis", "Sessões de usuário\nDados frequentes\nRate limiting")

    Container(db, "📊 Database", "PostgreSQL", "Dados principais\nClientes, veículos, serviços\nTransações ACID")
    Container(storage, "📁 File Storage", "S3 / Minio", "Fotos de diagnóstico\nComprovantes de pagamento\nRecibos de serviço")
}

System_Ext(email_service, "📧 Email Service", "SMTP Provider\nSendGrid / AWS SES")
System_Ext(sms_service, "📱 SMS Service", "Twilio / AWS SNS")
System_Ext(payment_service, "💳 Payment Service", "Stripe / PayPal")

' Fluxo dos usuários
Rel(cliente, web_app, "HTTPS", "Acessa como cliente")
Rel(recepcionista, web_app, "HTTPS", "Gerencia dados")
Rel(mecanico, mobile_app, "HTTPS", "Atualiza progresso")
Rel(gerente, web_app, "HTTPS", "Visualiza relatórios")

' Fluxo interno
Rel(web_app, api, "REST / JSON", "HTTP requests")
Rel(mobile_app, api, "REST / JSON", "HTTP requests")

Rel(api, cache, "", "Lê/escreve cache")
Rel(api, db, "SQL", "Persiste dados")
Rel(api, storage, "Multipart", "Upload/download arquivos")

Rel(api, email_service, "SMTP", "Envia emails")
Rel(api, sms_service, "SMS API", "Envia SMS")
Rel(api, payment_service, "HTTPS", "Processa pagamentos")

Rel_Back(cache, api, "", "Retorna dados")

SHOW_LEGEND()
@enduml
