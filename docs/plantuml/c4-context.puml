@startuml C4 Context - API Oficina Mecanica
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()
SHOW_PERSON_OUTLINE()

Person(operator, "Operador Autenticado", "Atendente, mecanico, estoquista ou gerente; acesso conforme JWT e permissoes RBAC")
Person(customer, "Cliente do Veiculo", "Recebe o orcamento e confirma aprovacao ou recusa via token")
System(api, "API Oficina Mecanica", "Monolito modular em TypeScript/Fastify: Auth, Registry e Service Order; avaliacao da OS, insumos, orcamento e historico.")
System_Ext(smtp, "Servidor SMTP", "Entrega e-mails de orcamento e veiculo pronto para retirada")

Rel(operator, api, "Autentica, cadastra clientes/veiculos e gerencia OS; mecanico registra descricao na avaliacao", "HTTP/JSON + Bearer JWT")
Rel(api, smtp, "Envia descricao da OS, valor e link de aprovacao; notifica conclusao", "SMTP / Nodemailer")
Rel(smtp, customer, "Entrega notificacoes", "E-mail HTML/Texto")
Rel(customer, api, "Acessa /orcamento/:token e confirma decisao em /budget-approvals/decide", "HTTP/HTML e JSON")

note right of api
    Auth, Registry e Service Order sao ativados por src/index.ts.
    A descricao da OS pode ser revisada em PENDING
    por mecanico ou gerente (OS_CONCLUIR).
    Stock possui dominio/aplicacao, mas seus handlers
    nao sao ativados pelo bootstrap atual.
    PostgreSQL e detalhado no nivel de containers (C2).
end note

SHOW_LEGEND()
@enduml
