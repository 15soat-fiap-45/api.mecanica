@startuml C4 Components - Arquitetura Interna API
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(api_server, "API Server (Node.js/Express)") {

    ' HTTP Layer
    Component(express, "Express Server", "HTTP Server", "Roteamento\nMiddleware\nError handling")

    ' Route Layer (HTTP Routing)
    Boundary(routes, "Rotas REST") {
        Component(client_routes, "Client Routes", "Express Router", "POST /clients\nGET /clients/:id\nPUT /clients/:id")
        Component(order_routes, "Order Routes", "Express Router", "POST /orders\nPUT /orders/:id\nGET /orders")
        Component(payment_routes, "Payment Routes", "Express Router", "POST /payments\nGET /payments/:id")
        Component(auth_routes, "Auth Routes", "Express Router", "POST /login\nPOST /refresh\nPOST /logout")
    }

    ' Controller Layer
    Boundary(controllers, "Controllers") {
        Component(client_ctrl, "ClientController", "Request Handler", "Recebe POST /clients\nValida entrada\nChama service")
        Component(order_ctrl, "ServiceOrderController", "Request Handler", "Recebe POST /orders\nValida entrada")
        Component(payment_ctrl, "PaymentController", "Request Handler", "Recebe POST /payments")
        Component(auth_ctrl, "AuthController", "Request Handler", "Recebe POST /login")
    }

    ' Service Layer (Business Logic)
    Boundary(services, "Services (Lógica de Negócio)") {
        Component(client_svc, "ClientService", "Business Logic", "Validações\nDetecção de duplicata\nHash de senha")
        Component(order_svc, "ServiceOrderService", "Business Logic", "Criar ordem\nAtualizar status\nCálculos de preço")
        Component(payment_svc, "PaymentService", "Business Logic", "Integração Stripe\nWebhooks\nCobrança")
        Component(auth_svc, "AuthService", "Business Logic", "JWT tokens\nAutenticação\nPermissões")
    }

    ' Repository Layer (Data Access)
    Boundary(repositories, "Repositories (Data Access)") {
        Component(client_repo, "ClientRepository", "ORM/Query", "CRUD clientes\nQueries customizadas")
        Component(order_repo, "ServiceOrderRepository", "ORM/Query", "CRUD ordens\nFiltros avançados")
        Component(payment_repo, "PaymentRepository", "ORM/Query", "CRUD pagamentos\nHistórico")
    }

    ' Middleware & Utils
    Boundary(utils, "Middleware & Utilities") {
        Component(auth_middleware, "Auth Middleware", "Middleware", "Verifica JWT\nValida permissões")
        Component(cors_middleware, "CORS Middleware", "Middleware", "Permite origens\nHeaders CORS")
        Component(error_handler, "Error Handler", "Middleware", "Captura erros\nFormatação resposta")
        Component(logger, "Logger", "Winston", "Log estruturado\nAuditoria")
        Component(config, "Config", "Environment", "Variáveis de ambiente\nSecretos")
    }
}

Container_Boundary(external, "External Services & Storage") {
    Database(postgres_db, "PostgreSQL", "Database")
    Component(redis_cache, "Redis Cache", "In-Memory Store", "Sessões\nDados frequentes")
    Component(bull_queue, "Bull Queue", "Job Queue", "Async jobs\nRetries")
    Component(email_srv, "Email Service", "SMTP", "SendGrid/AWS SES")
    Component(payment_api, "Payment API", "Stripe/PayPal", "Processamento")
    Component(sms_srv, "SMS Service", "Twilio/AWS SNS", "Notificações")
    Component(s3_storage, "File Storage", "S3/Minio", "Documentos")
}

' HTTP Entry Point
Rel(express, auth_middleware, "aplica")
Rel(express, cors_middleware, "aplica")
Rel(express, error_handler, "aplica")
Rel(express, client_routes, "roteia para")
Rel(express, order_routes, "roteia para")
Rel(express, payment_routes, "roteia para")
Rel(express, auth_routes, "roteia para")

' Routes to Controllers
Rel(client_routes, client_ctrl, "")
Rel(order_routes, order_ctrl, "")
Rel(payment_routes, payment_ctrl, "")
Rel(auth_routes, auth_ctrl, "")

' Controllers to Services
Rel(client_ctrl, client_svc, "chama")
Rel(order_ctrl, order_svc, "chama")
Rel(payment_ctrl, payment_svc, "chama")
Rel(auth_ctrl, auth_svc, "chama")

' Services to Repositories
Rel(client_svc, client_repo, "usa")
Rel(order_svc, order_repo, "usa")
Rel(order_svc, payment_svc, "chama")
Rel(payment_svc, payment_repo, "usa")
Rel(auth_svc, redis_cache, "lê/escreve")

' Services to External
Rel(client_svc, email_srv, "SMTP")
Rel(order_svc, bull_queue, "publica jobs")
Rel(order_svc, sms_srv, "SMS API")
Rel(payment_svc, payment_api, "HTTPS")

' Repositories to Database
Rel(client_repo, postgres_db, "SQL")
Rel(order_repo, postgres_db, "SQL")
Rel(payment_repo, postgres_db, "SQL")

' Logging
Rel(client_svc, logger, "log", "back")
Rel(order_svc, logger, "log", "back")
Rel(express, config, "lê", "back")

' Legenda
SHOW_LEGEND()
@enduml
