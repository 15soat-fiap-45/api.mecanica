@startuml Modelo E-R - Schema Drizzle Atual
hide circle
skinparam linetype ortho

package "Schema public" {
    entity "auth_users" as auth_users {
        * id : UUID <<PK>>
        --
        email : VARCHAR(320) <<UNIQUE>>
        password_hash : TEXT
        role : auth_role
        status : auth_user_status
    }

    entity "cliente" as cliente {
        * cliente_id : VARCHAR(14) <<PK>>
        --
        nome : VARCHAR(100)
        telefone : VARCHAR(11)
        email : VARCHAR(100)
        version : INTEGER
    }

    entity "veiculo" as veiculo {
        * veiculo_id : VARCHAR(36) <<PK>>
        --
        placa : VARCHAR(7) <<UNIQUE>>
        modelo : VARCHAR(30)
        ano : INTEGER
        marca : VARCHAR(16)
        cor : VARCHAR(15)
        version : INTEGER
        cliente_id : VARCHAR(14) <<FK>>
    }
}

package "Schema service_order" {
    entity "orders" as orders {
        * id : VARCHAR(36) <<PK>>
        --
        description : TEXT
        vehicle_id : VARCHAR(36) nullable
        value_cents : BIGINT nullable
        status : VARCHAR(20)
        version : INTEGER
    }

    entity "supply_items" as supply_items {
        * service_order_id : VARCHAR(36) <<PK, FK>>
        * part_code : VARCHAR(50) <<PK>>
        --
        quantity : INTEGER
        used : BOOLEAN
    }

    entity "budgets" as budgets {
        * id : VARCHAR(36) <<PK>>
        --
        service_order_id : VARCHAR(36) <<FK>>
        total_cents : BIGINT
        status : VARCHAR(20)
        version : INTEGER
    }

    entity "approval_requests" as approval_requests {
        * id : VARCHAR(36) <<PK>>
        --
        order_id : VARCHAR(36) <<FK>>
        budget_id : VARCHAR(36) <<FK>>
        budget_version : VARCHAR(64)
        token_hash : VARCHAR(64) <<UNIQUE>>
        created_at : TIMESTAMPTZ
        expires_at : TIMESTAMPTZ
        used_at : TIMESTAMPTZ nullable
        revoked_at : TIMESTAMPTZ nullable
        sent_at : TIMESTAMPTZ nullable
        decision : VARCHAR(8) nullable
        rejection_reason : TEXT nullable
    }

    entity "order_status_history" as order_status_history {
        * id : BIGINT <<PK, identity>>
        --
        order_id : VARCHAR(36) <<FK>>
        status : VARCHAR(20)
        value_cents : BIGINT nullable
        changed_by : VARCHAR(320) nullable
        recorded_at : TIMESTAMPTZ
    }
}

package "Schema business_intelligence" {
    entity "service_order_timeline" as service_order_timeline {
        * service_order_id : VARCHAR(36) <<PK>>
        --
        registered_at : TIMESTAMPTZ nullable
        execution_started_at : TIMESTAMPTZ nullable
        finished_at : TIMESTAMPTZ nullable
        delivered_at : TIMESTAMPTZ nullable
        cancelled_at : TIMESTAMPTZ nullable
        updated_at : TIMESTAMPTZ
    }

    entity "restock_cycle" as restock_cycle {
        * id : VARCHAR(36) <<PK>>
        --
        part_code : VARCHAR(50)
        opened_at : TIMESTAMPTZ
        closed_at : TIMESTAMPTZ nullable
        quantity_at_open : INTEGER
        restocked_quantity : INTEGER nullable
    }
}

cliente ||--o{ veiculo : possui
veiculo ||..o{ orders : referencia logica (vehicle_id)
orders ||--o{ supply_items : contem
orders ||--o{ budgets : gera
orders ||--o{ approval_requests : solicita aprovacao
budgets ||--o{ approval_requests : vinculado a
orders ||--o{ order_status_history : audita transicoes

orders ||..o{ service_order_timeline : projecao analitica (sem FK fisica)
supply_items ||..o{ restock_cycle : projecao por part_code (sem FK fisica)

note bottom of service_order_timeline
  Projecao de leitura do modulo Business Intelligence alimentada exclusivamente
  via eventos do barramento. Sem FKs transcontextuais para garantir isolamento.
end note
@enduml
